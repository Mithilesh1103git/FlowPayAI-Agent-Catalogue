# Nebius Token Factory (OpenAI-compatible API)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/Nemotron-3.5-Super-VL
NEBIUS_TIMEOUT_SECONDS=60
NEBIUS_MAX_RETRIES=2

# Optional per-agent model overrides (default: NEBIUS_MODEL)
# PLANNER_MODEL=nvidia/Nemotron-3.5-Super-VL
# RESEARCH_MODEL=nvidia/Nemotron-3.5-Super-VL
# COMPARISON_MODEL=nvidia/Nemotron-3.5-Super-VL
# ADVISOR_MODEL=nvidia/Nemotron-3.5-Super-VL

CHANNEL3_API_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_URL=https://YOUR-PUBLIC-HOST/paypal/webhook
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_TIMEOUT_SECONDS=15
PAYPAL_MAX_RETRIES=2
# Optional Vault token encryption. Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYPAL_VAULT_ENCRYPTION_KEY=
PAYPAL_VAULT_ENABLED=false
# Keep false until FraudNet/Magnes RDA is implemented and verified.
PAYPAL_VAULT_CHARGES_ENABLED=false
PAYPAL_RDA_ENABLED=false
# Demo buyer identity; replace with authenticated user identity in production.
FLOWPAY_DEMO_BUYER_ID=demo-buyer-001
APP_RETURN_URL=https://YOUR-PUBLIC-HOST/paypal/return
APP_CANCEL_URL=https://YOUR-PUBLIC-HOST/paypal/cancel
FLOWPAY_DB_PATH=./data/flowpayai.sqlite3
FLOWPAY_DUCKDB_PATH=./data/flowpayai.duckdb
WEB_APP_LINK=https://YOUR-PUBLIC-HOST
